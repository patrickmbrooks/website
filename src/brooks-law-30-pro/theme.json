{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1160px"
		},
		"color": {
			"custom": true,
			"customGradient": true,
			"defaultPalette": false,
			"palette": [
				{ "slug": "court", "name": "Court (deep slate)", "color": "#12202e" },
				{ "slug": "court-2", "name": "Court panel", "color": "#1b2c3d" },
				{ "slug": "paper", "name": "Paper", "color": "#ffffff" },
				{ "slug": "limestone", "name": "Limestone", "color": "#f5f2ea" },
				{ "slug": "ink", "name": "Ink", "color": "#222933" },
				{ "slug": "muted", "name": "Muted", "color": "#4b5563" },
				{ "slug": "brass", "name": "Brass", "color": "#b08d3e" },
				{ "slug": "brass-bright", "name": "Brass bright", "color": "#d9b45c" },
				{ "slug": "oxblood", "name": "Oxblood", "color": "#7c2d2d" },
				{ "slug": "link", "name": "Link blue", "color": "#14538c" }
			]
		},
		"typography": {
			"customFontSize": true,
			"lineHeight": true,
			"letterSpacing": true,
			"dropCap": true,
			"fontFamilies": [
				{ "slug": "serif", "name": "Serif (headings)", "fontFamily": "Georgia, \"Times New Roman\", Times, serif" },
				{ "slug": "sans", "name": "Sans (body)", "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, Ubuntu, Cantarell, \"Helvetica Neue\", Arial, sans-serif" },
				{ "slug": "mono", "name": "Mono", "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" }
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem" },
				{ "slug": "large", "name": "Large", "size": "1.35rem" },
				{ "slug": "x-large", "name": "Extra large", "size": "clamp(1.55rem, 2.2vw + 0.7rem, 2.15rem)" },
				{ "slug": "xx-large", "name": "Display", "size": "clamp(2rem, 4vw + 0.8rem, 3.1rem)" }
			]
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true,
			"units": [ "px", "rem", "em", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "0.5rem" },
				{ "slug": "20", "name": "S", "size": "1rem" },
				{ "slug": "30", "name": "M", "size": "2rem" },
				{ "slug": "40", "name": "L", "size": "clamp(2.5rem, 6vw, 4rem)" },
				{ "slug": "50", "name": "XL", "size": "clamp(3.2rem, 8vw, 5.5rem)" }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": true
		},
		"blocks": {
			"core/button": {
				"border": { "radius": true }
			}
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"color": {
			"text": "var(--wp--preset--color--ink)"
		},
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontWeight": "700" }
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--link)" }
			},
			"button": {
				"color": { "background": "#c8a04a", "text": "#222933" },
				"border": { "radius": "3px" }
			}
		}
	}
}
