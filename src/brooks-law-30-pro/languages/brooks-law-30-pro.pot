msgstr ""

#: inc/site-tuning.php:198
msgid "Send security headers"
msgstr ""

#: inc/site-tuning.php:199
msgid "nosniff, frame protection, referrer policy, and a permissions policy that declines camera, microphone, location, and payment APIs the site never uses. Transport security (HSTS) is left to Cloudflare, which owns it."
msgstr ""

#: inc/site-tuning.php:202
msgid "Hide the user list from the public API"
msgstr ""

#: inc/site-tuning.php:203
msgid "Logged-out requests to /wp-json/wp/v2/users stop revealing account usernames. Editing and admin screens are unaffected."
msgstr ""

#: inc/site-tuning.php:206
msgid "Trim unused head links"
msgstr ""

#: inc/site-tuning.php:207
msgid "Removes RSD, shortlink, oEmbed discovery, and the extra feed links, including comment feeds for a site with comments closed. The main content feed stays."
msgstr ""

#: inc/site-tuning.php:210
msgid "Disable XML-RPC"
msgstr ""

#: inc/site-tuning.php:211
msgid "XML-RPC lets one request carry many login attempts, which is why it is a favourite of brute-force tools. Turn this OFF only if you use the WordPress mobile app or Jetpack. If Docket Suite is already disabling XML-RPC, this stands down automatically rather than doing it twice."
msgstr ""

#: inc/speculation.php:109
msgid "Prefetch links on hover"
msgstr ""

#: inc/speculation.php:110
msgid "Loads the next page in the background once a visitor hovers a link, so it appears immediately when clicked. Prefetch only — pages are never executed in advance, so analytics stay accurate. Ignored automatically if WordPress is handling this itself."
msgstr ""

