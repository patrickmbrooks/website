# Backend server
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Shared secret the mobile app sends in X-Api-Key header. Rotate periodically.
API_KEY=changeme-please

# SQLite file path (audit trail: consent records + background-check reports).
DATABASE_PATH=./data/app.db

# CRA provider: 'mock' (local dev, returns fake results) or 'checkr'.
CRA_PROVIDER=mock

# Checkr credentials (only required when CRA_PROVIDER=checkr).
# Use your TEST key during development; live key only in production.
CHECKR_API_KEY=
CHECKR_WEBHOOK_SECRET=
CHECKR_BASE_URL=https://api.checkr.com

# RevenueCat REST v1 API key (secret, server-side) — used to verify the
# calling user's entitlement server-side. Optional in dev.
REVENUECAT_REST_API_KEY=
